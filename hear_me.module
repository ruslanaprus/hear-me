<?php

use Drupal\Core\Entity\EntityInterface;
use Drupal\node\NodeInterface;

/**
 * Implements hook_entity_presave().
 */
function hear_me_entity_presave(EntityInterface $entity): void {
  if (!$entity instanceof NodeInterface || $entity->isNew()) {
    return;
  }

  $nodeAudioQueue = \Drupal::service('hear_me.node_audio_queue');
  $attacher = \Drupal::service('hear_me.node_audio_attacher');
  $queueItem = $nodeAudioQueue->buildQueueItem($entity);
  if ($attacher->shouldRetractGeneratedAudio($entity, $queueItem)) {
    $attacher->removeGeneratedAudioReferences($entity);
  }
}

/**
 * Implements hook_entity_insert().
 *
 * When a new node is created, queues it for background TTS pre-generation
 * if its bundle is listed in the hear_me.settings queue_bundles setting.
 *
 * The list of bundles is configured at Administration > Configuration >
 * Media > HearMe TTS Settings. No bundles are enabled by default (opt-in)
 */
function hear_me_entity_insert(EntityInterface $entity): void {
  if ($entity instanceof NodeInterface) {
    \Drupal::service('hear_me.node_audio_attacher')->queueNodeAfterTransaction((int) $entity->id());
  }
}

/**
 * Implements hook_entity_update().
 */
function hear_me_entity_update(EntityInterface $entity): void {
  if (!$entity instanceof NodeInterface) {
    return;
  }

  $attacher = \Drupal::service('hear_me.node_audio_attacher');
  $nodeAudioQueue = \Drupal::service('hear_me.node_audio_queue');
  $queueIfMissing = $nodeAudioQueue->hasAudioSourceChanged($entity);
  $original = $entity->getOriginal();
  if ($original instanceof NodeInterface) {
    $attacher->cleanupRemovedGeneratedAudio($original, $entity);
    if (!$original->isPublished() && $entity->isPublished()) {
      $queueIfMissing = TRUE;
    }
  }
  $attacher->recheckEligibilityAfterTransaction((int) $entity->id(), $queueIfMissing);
}

/**
 * Implements hook_entity_delete().
 */
function hear_me_entity_delete(EntityInterface $entity): void {
  if ($entity instanceof NodeInterface) {
    \Drupal::service('hear_me.node_audio_attacher')->cleanupRemovedGeneratedAudio($entity);
  }
}

/**
 * Implements hook_cron().
 */
function hear_me_cron() {
  \Drupal::service('hear_me.cache_manager')->cleanup();
  \Drupal::service('hear_me.node_audio_attacher')->publishPendingGeneratedAudioCleanup();
}
