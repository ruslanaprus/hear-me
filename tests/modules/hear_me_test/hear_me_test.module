<?php

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Access\AccessResultInterface;
use Drupal\Core\Field\FieldDefinitionInterface;
use Drupal\Core\Field\FieldItemListInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\file\FileInterface;
use Drupal\media\MediaInterface;
use Drupal\node\NodeInterface;

/**
 * Implements hook_entity_field_access().
 */
function hear_me_test_entity_field_access(string $operation, FieldDefinitionInterface $field_definition, AccountInterface $account, ?FieldItemListInterface $items = NULL): AccessResultInterface {
  $deniedField = (string) \Drupal::state()->get('hear_me_test.denied_anonymous_field', '');
  if ($operation === 'view' && $account->isAnonymous() && $field_definition->getName() === $deniedField) {
    return AccessResult::forbidden();
  }

  return AccessResult::neutral();
}

/**
 * Implements hook_file_presave().
 */
function hear_me_test_file_presave(FileInterface $file): void {
  if (\Drupal::state()->get('hear_me_test.fail_file_save', FALSE)) {
    throw new \RuntimeException('Simulated File save failure.');
  }
}

/**
 * Implements hook_media_presave().
 */
function hear_me_test_media_presave(MediaInterface $media): void {
  if (\Drupal::state()->get('hear_me_test.fail_media_save', FALSE)) {
    throw new \RuntimeException('Simulated Media save failure.');
  }
}

/**
 * Implements hook_node_grants().
 */
function hear_me_test_node_grants(AccountInterface $account, string $operation): array {
  if ($operation !== 'view') {
    return [];
  }

  return \Drupal::state()->get('hear_me_test.node_access_enabled', FALSE)
    ? ['hear_me_test' => [1]]
    : ['all' => [0]];
}

/**
 * Implements hook_node_access_records().
 */
function hear_me_test_node_access_records(NodeInterface $node): array {
  if (!\Drupal::state()->get('hear_me_test.node_access_enabled', FALSE)) {
    return [[
      'realm' => 'all',
      'gid' => 0,
      'grant_view' => 1,
      'grant_update' => 0,
      'grant_delete' => 0,
    ]];
  }

  return [[
    'realm' => 'hear_me_test',
    'gid' => $node->isPromoted() ? 1 : 2,
    'grant_view' => 1,
    'grant_update' => 0,
    'grant_delete' => 0,
  ]];
}
